{
  "sap.app": {
    "id": "orders",
    "type": "application",
    "title": "Orders App",
    "applicationVersion": {
      "version": "1.0.0"
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "orders.view.Orders",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {}
      }
    },
    "models": {},
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "orders.view",
        "controlId": "rootApp",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        {
          "name": "orders",
          "pattern": "",
          "target": "orders"
        },
        {
          "name": "detail",
          "pattern": "orders/{orderId}",
          "target": "detail"
        }
      ],
      "targets": {
        "orders": {
          "viewName": "Orders"
        },
        "detail": {
          "viewName": "Detail"
        }
      }
    }
  }
}
