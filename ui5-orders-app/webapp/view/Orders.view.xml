<mvc:View
  controllerName="orders.controller.Orders"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc">

  <App id="rootApp">
    <Page title="Orders App">
      <content>

        <List
          items="{
            path: '/Orders',
            parameters: { $orderby: 'date asc' }
          }">

          <headerToolbar>
            <Toolbar>
              <Title text="Lista de Órdenes" />
              <ToolbarSpacer />
              <Button
                text="Nueva Orden"
                icon="sap-icon://add"
                press=".onCreateOrder" />
            </Toolbar>
          </headerToolbar>

          <ObjectListItem
            title="{id}"
            number="{amount}"
            numberUnit="USD"
            type="Navigation"
            press=".onOrderPress">

            <attributes>
              <ObjectAttribute text="{customer}" />
              <ObjectAttribute text="{date}" />
            </attributes>

            <firstStatus>
              <ObjectStatus
                text="{status}"
                state="{
                  path: 'status',
                  formatter: '.formatStatus'
                }" />
            </firstStatus>

          </ObjectListItem>

        </List>

      </content>
    </Page>
  </App>

</mvc:View>