<mvc:View
  controllerName="orders.controller.Orders"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc">

  <App id="rootApp">
    <Page title="Orders App">
      <content>

       <List
  id="ordersList"
  mode="Delete"
  delete=".onDeleteOrder"
  items="{
    path: '/Orders',
    parameters: { $orderby: 'date asc' }
  }">

  <headerToolbar>
    <Toolbar>
      <Title text="Lista de Órdenes" />
      <ToolbarSpacer />
      <SearchField
        width="30%"
        placeholder="Buscar por cliente o ID..."
        liveChange=".onSearch" />
      <Button
        text="Nueva Orden"
        icon="sap-icon://add"
        press=".onCreateOrder" />
    </Toolbar>
  </headerToolbar>

  <ObjectListItem
  title="{id}"
  number="{amount}"
  numberUnit="USD"
  type="Navigation"
  press=".onOrderPress">

    <attributes>
      <ObjectAttribute text="{customer}" />
      <ObjectAttribute text="{date}" />
    </attributes>

    <firstStatus>
      <ObjectStatus
        text="{status}"
        state="{
          path: 'status',
          formatter: '.formatStatus'
        }" />
    </firstStatus>

  </ObjectListItem>

</List>

      </content>
    </Page>
  </App>

</mvc:View>